# ─── AI Provider (set ONE) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ─── RPC Endpoints ────────────────────────────────────────────────────────────
# WebSocket (preferred for real-time mempool monitoring)
RPC_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# HTTP fallback
RPC_HTTP_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
